<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_LoanApproval"
                  targetNamespace="http://example.com/loan-approval"
                  exporter="Camunda Modeler" exporterVersion="5.34.0"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="LoanApprovalProcess" name="End-to-End Loan Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanApplication" name="Loan application received">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateApplicant" name="Validate applicant details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-applicant" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Validation" name="Applicant valid?" default="Flow_Validation_Failed">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Validation_Passed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Validation_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Invalid" name="Rejected - invalid application">
      <bpmn:incoming>Flow_Validation_Failed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_CreditAssessment" name="Call simulated credit assessment API" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;POST&quot;" target="method" />
          <zeebe:input source="= creditApiUrl + &quot;/api/credit-assessments&quot;" target="url" />
          <zeebe:input source="= { applicantId: applicantId, monthlyIncome: monthlyIncome, requestedLoanAmount: requestedLoanAmount, simulatedCreditScore: simulatedCreditScore, simulateCreditApiFailure: simulateCreditApiFailure }" target="body" />
          <zeebe:input source="= { &quot;Content-Type&quot;: &quot;application/json&quot; }" target="headers" />
          <zeebe:input source="= 10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="= 20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="resultExpression" value="= { creditScore: response.body.creditScore, riskBand: response.body.riskBand, assessmentReference: response.body.assessmentReference, assessmentStatus: response.body.assessmentStatus, creditProvider: response.body.provider, creditAssessedAt: response.body.assessedAt }" />
          <zeebe:header key="retryBackoff" value="PT5S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Validation_Passed</bpmn:incoming>
      <bpmn:outgoing>Flow_Credit_DMN</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_EvaluateLoanDecision" name="Evaluate loan eligibility (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loanEligibilityDecision" resultVariable="loanDecisionResult" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Credit_DMN</bpmn:incoming>
      <bpmn:outgoing>Flow_DMN_DecisionGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_LoanDecision" name="DMN outcome?" default="Flow_Decision_Manual">
      <bpmn:incoming>Flow_DMN_DecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Approved" name="Loan approved">
      <bpmn:incoming>Flow_Decision_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Loan rejected">
      <bpmn:incoming>Flow_Decision_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_ManualReview" name="Manual loan review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="loan-review-form" bindingType="deployment" />
        <zeebe:assignmentDefinition candidateGroups="loan-reviewers" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Reviewer outcome?" default="Flow_Review_Rejected">
      <bpmn:incoming>Flow_Review_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_LoanApplication" targetRef="Task_ValidateApplicant" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateApplicant" targetRef="Gateway_Validation" />
    <bpmn:sequenceFlow id="Flow_Validation_Passed" name="Valid" sourceRef="Gateway_Validation" targetRef="Task_CreditAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Validation_Failed" name="Invalid" sourceRef="Gateway_Validation" targetRef="EndEvent_Invalid" />
    <bpmn:sequenceFlow id="Flow_Credit_DMN" sourceRef="Task_CreditAssessment" targetRef="Task_EvaluateLoanDecision" />
    <bpmn:sequenceFlow id="Flow_DMN_DecisionGateway" sourceRef="Task_EvaluateLoanDecision" targetRef="Gateway_LoanDecision" />
    <bpmn:sequenceFlow id="Flow_Decision_Approved" name="Approved" sourceRef="Gateway_LoanDecision" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= loanDecisionResult.decision = &quot;APPROVED&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Rejected" name="Rejected" sourceRef="Gateway_LoanDecision" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= loanDecisionResult.decision = &quot;REJECTED&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Manual" name="Manual review" sourceRef="Gateway_LoanDecision" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_Review_Gateway" sourceRef="Task_ManualReview" targetRef="Gateway_ReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_Review_Approved" name="Reviewer approves" sourceRef="Gateway_ReviewOutcome" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewOutcome = &quot;APPROVE&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_Rejected" name="Reviewer rejects / default" sourceRef="Gateway_ReviewOutcome" targetRef="EndEvent_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApproval" bpmnElement="LoanApprovalProcess">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_LoanApplication"><dc:Bounds x="120" y="230" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_ValidateApplicant"><dc:Bounds x="220" y="208" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ValidationGateway" bpmnElement="Gateway_Validation" isMarkerVisible="true"><dc:Bounds x="425" y="223" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InvalidEnd" bpmnElement="EndEvent_Invalid"><dc:Bounds x="432" y="390" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Credit" bpmnElement="Task_CreditAssessment"><dc:Bounds x="535" y="208" width="175" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DMN" bpmnElement="Task_EvaluateLoanDecision"><dc:Bounds x="760" y="208" width="165" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DecisionGateway" bpmnElement="Gateway_LoanDecision" isMarkerVisible="true"><dc:Bounds x="985" y="223" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApprovedEnd" bpmnElement="EndEvent_Approved"><dc:Bounds x="1190" y="105" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RejectedEnd" bpmnElement="EndEvent_Rejected"><dc:Bounds x="1190" y="300" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualReview" bpmnElement="Task_ManualReview"><dc:Bounds x="1100" y="450" width="180" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReviewGateway" bpmnElement="Gateway_ReviewOutcome" isMarkerVisible="true"><dc:Bounds x="1380" y="470" width="50" height="50" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Start_Validate" bpmnElement="Flow_Start_Validate"><di:waypoint x="156" y="248"/><di:waypoint x="220" y="248"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Validate_Gateway" bpmnElement="Flow_Validate_Gateway"><di:waypoint x="370" y="248"/><di:waypoint x="425" y="248"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Validation_Passed" bpmnElement="Flow_Validation_Passed"><di:waypoint x="475" y="248"/><di:waypoint x="535" y="248"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Validation_Failed" bpmnElement="Flow_Validation_Failed"><di:waypoint x="450" y="273"/><di:waypoint x="450" y="390"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Credit_DMN" bpmnElement="Flow_Credit_DMN"><di:waypoint x="710" y="248"/><di:waypoint x="760" y="248"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DMN_Gateway" bpmnElement="Flow_DMN_DecisionGateway"><di:waypoint x="925" y="248"/><di:waypoint x="985" y="248"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Decision_Approved" bpmnElement="Flow_Decision_Approved"><di:waypoint x="1010" y="223"/><di:waypoint x="1010" y="123"/><di:waypoint x="1190" y="123"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Decision_Rejected" bpmnElement="Flow_Decision_Rejected"><di:waypoint x="1035" y="248"/><di:waypoint x="1110" y="248"/><di:waypoint x="1110" y="318"/><di:waypoint x="1190" y="318"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Decision_Manual" bpmnElement="Flow_Decision_Manual"><di:waypoint x="1010" y="273"/><di:waypoint x="1010" y="495"/><di:waypoint x="1100" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Review_Gateway" bpmnElement="Flow_Review_Gateway"><di:waypoint x="1280" y="495"/><di:waypoint x="1380" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Review_Approved" bpmnElement="Flow_Review_Approved"><di:waypoint x="1405" y="470"/><di:waypoint x="1405" y="123"/><di:waypoint x="1226" y="123"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Review_Rejected" bpmnElement="Flow_Review_Rejected"><di:waypoint x="1430" y="495"/><di:waypoint x="1500" y="495"/><di:waypoint x="1500" y="318"/><di:waypoint x="1226" y="318"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
